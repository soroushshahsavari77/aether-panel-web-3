# =====================================================================================================
# Aether Web Panel — environment sample / نمونه‌ی متغیرهای محیطی
#
# EN: Railway/Render: paste these into the service "Variables"/"Environment" UI (do NOT commit real secrets).
#     Docker: `docker run --env-file .env ...`. NOTE: `--env-file` does not strip inline comments, so every
#     comment in this file lives on its own line. Uncomment a line (remove "# ") to enable it.
# FA: روی Railway/Render این‌ها را در بخش Variables/Environment وارد کنید (رمز واقعی را در ریپو نگذارید).
#     در Docker از `--env-file` استفاده کنید. کامنت‌ها عمداً در خط جدا هستند چون `--env-file` کامنت هم‌خط را
#     حذف نمی‌کند. برای فعال‌سازی یک خط، علامت "# " ابتدای آن را بردارید.
# Reference / مرجع کامل: README.md (§ Environment / متغیرهای محیطی)
# =====================================================================================================


# ---- 1) REQUIRED / الزامی -------------------------------------------------------------------------
# Panel login (Basic Auth). If either is empty the panel answers 503 and serves nothing.
# ورود به پنل (Basic Auth). اگر هرکدام خالی باشد پنل 503 می‌دهد.
PANEL_USER=admin
PANEL_PASSWORD=change-me-to-a-long-random-string


# ---- 2) Panel / پنل ---------------------------------------------------------------------------------
# HTTP port of the panel. On Railway/Render the platform injects PORT itself; the image default is 3000.
# پورت HTTP پنل. روی Railway/Render خود پلتفرم PORT را می‌دهد؛ پیش‌فرض ایمیج ۳۰۰۰ است.
# PORT=3000
# Bind address of the panel HTTP server (server.mjs).
# آدرس bind سرور HTTP پنل.
# HOSTNAME_BIND=0.0.0.0


# ---- 3) Persistence / stability — ماندگاری و پایداری ---------------------------------------------------
# Data directory. Put it on a persistent volume (keeps settings, share credentials, WARP identity, relay binaries).
# Railway: add a Volume mounted at /data, then set TMPDIR=/data/tmp.
# محل داده‌ها. روی Volume بگذارید (تنظیمات، رمز اشتراک، هویت WARP و باینری رله‌ها را نگه می‌دارد).
# TMPDIR=/data/tmp
# 1 = hide the "not on a volume" warning banner.
# 1 = بنر هشدار ماندگاری نمایش داده نشود.
# PERSISTENCE_OK=1
# 1 = reconnect the tunnel automatically after every restart using the saved config.
# 1 = بعد از هر ری‌استارت، تونل با تنظیمات ذخیره‌شده خودکار وصل شود.
# AUTO_START=1
# Aether binary path (preset in the Docker image).
# مسیر باینری Aether (در ایمیج Docker تنظیم است).
# AETHER_BIN=/opt/aether/aether
# Pinned Aether release (preset in the Docker image; also pins the in-panel installer).
# نسخه‌ی پین‌شده‌ی Aether (در ایمیج تنظیم است؛ installer داخل پنل هم از آن استفاده می‌کند).
# AETHER_VERSION=v1.5.0


# ---- 4) Watchdog & best-config (all optional; defaults shown) — واچ‌داگ و بهترین کانفیگ ------------------
# Tick period of the watchdog loop / فاصله‌ی tick واچ‌داگ
# WATCHDOG_TICK_SEC=5
# Health-check period (a real request through the tunnel) / فاصله‌ی health check
# WATCHDOG_INTERVAL_SEC=30
# Timeout of each health check / مهلت هر health check
# WATCHDOG_PROBE_TIMEOUT_SEC=10
# Consecutive failed checks before a restart / شکست متوالی تا ری‌استارت
# WATCHDOG_MAX_FAILURES=3
# Restart if stuck scanning/connecting this long / ری‌استارت اگر این‌قدر در اسکن/اتصال گیر کند
# WATCHDOG_STUCK_SEC=300
# Restart backoff: base * 2^n, capped / backoff ری‌استارت: base * 2^n با سقف
# WATCHDOG_BACKOFF_BASE_SEC=2
# WATCHDOG_BACKOFF_MAX_SEC=300
# Failed starts in a row before falling back to the last known-good preset / استارت ناموفق تا بازگشت به کانفیگ سالم
# WATCHDOG_FALLBACK_AFTER=3
# Connected this long = the preset is recorded as known-good / اتصال پایدار این‌قدر = کانفیگ سالم
# WATCHDOG_STABLE_SEC=60
# Per-candidate connect timeout of "Find best config" / مهلت هر کاندید در «بهترین کانفیگ»
# BEST_TIMEOUT_SEC=45


# =====================================================================================================
# 5) SHARING & GATEWAY — اشتراک و gateway
#    Every relay is independent: one failing never affects another.
#    هر رله مستقل است؛ خرابی یکی روی بقیه اثری ندارد.
# =====================================================================================================

# Initial share credentials. Used only until settings are saved from the UI (then the saved file wins).
# Username 3-32 chars, password 8-64 chars, allowed characters: A-Za-z0-9._~-
# مقدار اولیه‌ی اشتراک؛ فقط تا قبل از ذخیره از رابط. نام کاربری ۳–۳۲ و رمز ۸–۶۴ کاراکتر از A-Za-z0-9._~-
# SHARE_USERNAME=myuser
# SHARE_PASSWORD=my-long-password
# Fixed remote port requested from bore (1024-65535). Empty = random.
# پورت ثابت درخواستی از bore (۱۰۲۴ تا ۶۵۵۳۵)؛ خالی = تصادفی.
# SHARE_PORT=33911
# 1 = start the relays automatically when the tunnel connects.
# 1 = با اتصال تونل، رله‌ها خودکار روشن شوند.
# SHARE_AUTO=1

# Protocols accepted on every TCP relay port (detected from the first bytes):
#   socks = SOCKS5 user/pass (unencrypted hop), http = HTTP CONNECT (unencrypted hop), ss = Shadowsocks AEAD (encrypted)
# Tip: SHARE_PROTOCOLS=ss exposes only the encrypted protocol.
# پروتکل‌هایی که هر پورت TCP می‌پذیرد. socks و http رمزنگاری ندارند؛ ss رمزنگاری‌شده است.
# SHARE_PROTOCOLS=socks,http,ss
# Shadowsocks cipher: chacha20-ietf-poly1305 (default) | aes-256-gcm | aes-128-gcm. The password is the share password.
# رمزگذار Shadowsocks. رمز آن همان رمز اشتراک است.
# SS_CIPHER=chacha20-ietf-poly1305
# Fixed local gateway port. REQUIRED for playit.gg and LocalToNet (their tunnel must target 127.0.0.1:GATEWAY_PORT).
# پورت محلی ثابت gateway. برای playit.gg و LocalToNet الزامی است.
# GATEWAY_PORT=1081


# =====================================================================================================
# 6) PRIMARY RELAYS — رله‌های اصلی
# =====================================================================================================

# ---- Railway TCP Proxy (see README.md / README-DEPLOY.md) ----------------------------------------------
# Fixed container port the gateway listens on. Must equal the "Application port" of Railway's TCP Proxy.
# Must not be PORT or PORT+1. If unset but a TCP Proxy exists, RAILWAY_TCP_APPLICATION_PORT is used.
# پورت ثابت gateway؛ باید با «Application port» در TCP Proxy یکی باشد و نباید PORT یا PORT+1 باشد.
# RELAY_PORT=1080
# Bind address of the relay listener.
# RELAY_BIND_HOST=0.0.0.0
# Injected by Railway when a TCP Proxy exists (do not set by hand on Railway):
# RAILWAY_TCP_PROXY_DOMAIN=roundhouse.proxy.rlwy.net
# RAILWAY_TCP_PROXY_PORT=12345
# RAILWAY_TCP_APPLICATION_PORT=1080
# Outside Railway (VPS etc.) set the public address of the relay yourself:
# خارج از Railway (مثلاً VPS) آدرس عمومی رله را خودتان بدهید:
# RELAY_PUBLIC_HOST=your.server.ip.or.domain
# RELAY_PUBLIC_PORT=1080

# ---- Panel domain: VLESS / Trojan over WebSocket (panel HTTP port; edge TLS on 443). Default: on ------------
# vless, trojan (comma separated) or off.
# INBOUND_WS=vless,trojan
# Secret WebSocket path (must start with "/", chars A-Za-z0-9._~-/, not /api/ or /_next).
# Default: /ws/<12 hex> derived from the share password.
# مسیر مخفی WebSocket. پیش‌فرض: /ws/<۱۲ hex> مشتق‌شده از رمز اشتراک.
# INBOUND_WS_PATH=/my-secret-path
# Public HTTP(S) domain used in the links. Default: RAILWAY_PUBLIC_DOMAIN or RENDER_EXTERNAL_HOSTNAME.
# Set it to your own domain (or a Cloudflare Worker domain in front of the panel) when needed.
# دامنه‌ی عمومی که در لینک‌ها می‌آید. پیش‌فرض: دامنه‌ی Railway/Render.
# INBOUND_PUBLIC_HOST=panel.example.com
# INBOUND_PUBLIC_PORT=443
# 0/off = plain ws:// (port 80); default is TLS.
# INBOUND_TLS=1

# ---- bore.pub (on by default, independent of Railway) ---------------------------------------------------
# BORE_SERVER=bore.pub
# BORE_VERSION=v0.6.0
# 0 = do not use bore at all.
# SHARE_BORE=0

# ---- playit.gg (create a TCP tunnel in the dashboard pointing at 127.0.0.1:GATEWAY_PORT) ----------------------
# PLAYIT_SECRET=
# host:port shown in the playit dashboard.
# PLAYIT_PUBLIC_ADDR=abc.gl.at.ply.gg:12345
# Optional: full custom argument list for the playit agent.
# PLAYIT_ARGS=
# PLAYIT_VERSION=0.15.26

# ---- Pinggy (uses the ssh client) -----------------------------------------------------------------------
# PINGGY_ENABLE=1
# Optional token (paid / persistent URLs).
# PINGGY_TOKEN=
# tcp = publish the gateway | tls = same with TLS | ws = HTTP tunnel to the panel port (VLESS/Trojan WS links)
# PINGGY_MODE=tcp
# PINGGY_SERVER=a.pinggy.io

# ---- ngrok TCP (TCP endpoints require a verified ngrok account) ------------------------------------------
# NGROK_AUTHTOKEN=
# NGROK_REGION=

# ---- chisel over HTTP/WebSocket to YOUR server ----------------------------------------------------------
# Server side: chisel server --reverse --port 8080 --auth user:pass   (put it behind a TLS reverse proxy / CDN)
# CHISEL_SERVER=https://edge.example.com
# CHISEL_AUTH=user:pass
# Port opened on your server (= the public port of this relay).
# CHISEL_REMOTE_PORT=8443
# Default: host of CHISEL_SERVER.
# CHISEL_PUBLIC_HOST=
# CHISEL_FINGERPRINT=
# Comma separated extra HTTP headers, K:V.
# CHISEL_HEADERS=Host:cdn.example.com,X-Token:abc
# --hostname (Host header / domain fronting).
# CHISEL_HOST_HEADER=
# CHISEL_TLS_SKIP_VERIFY=0
# CHISEL_KEEPALIVE=25s
# Also expose the panel HTTP port on your server (for your own TLS reverse proxy -> VLESS/Trojan).
# CHISEL_WS_REMOTE_PORT=
# CHISEL_VERSION=1.10.1

# ---- frp (frps on YOUR server; transport tcp | websocket | wss) -----------------------------------------
# Server side (frps.toml): bindPort = 7000, auth.method = "token", auth.token = "..."
# FRP_SERVER=1.2.3.4:7000
# FRP_TOKEN=
# FRP_TRANSPORT=websocket
# Must be open in the server firewall and allowed in frps allowPorts.
# FRP_REMOTE_PORT=6000
# FRP_PUBLIC_HOST=
# FRP_VERSION=0.61.1

# ---- rathole (server on YOUR host) ----------------------------------------------------------------------
# Server side (server.toml): [server] bind_addr="0.0.0.0:2333"; [server.services.aether] bind_addr="0.0.0.0:5000"
# RATHOLE_SERVER=1.2.3.4:2333
# Where the service is exposed by the server (host:port).
# RATHOLE_PUBLIC_ADDR=1.2.3.4:5000
# RATHOLE_TOKEN=
# Must match the service name in the server config.
# RATHOLE_SERVICE=aether
# tcp | noise | websocket
# RATHOLE_TRANSPORT=tcp
# websocket transport only.
# RATHOLE_TLS=0
# RATHOLE_NOISE_PATTERN=Noise_NK_25519_ChaChaPoly_BLAKE2s
# RATHOLE_REMOTE_PUBLIC_KEY=
# RATHOLE_VERSION=0.5.0


# =====================================================================================================
# 7) FALLBACK RELAYS — رله‌های پشتیبان
#    Unreliable: started only while NO primary relay is live, stopped when one comes back.
#    کم‌پایدار: فقط وقتی هیچ رله‌ی اصلی زنده نیست راه می‌افتند.
# =====================================================================================================
# SERVEO_ENABLE=1
# SERVEO_HOST=serveo.net
# The tunnel in the LocalToNet dashboard must target 127.0.0.1:GATEWAY_PORT.
# LOCALTONET_AUTHTOKEN=
# LOCALTONET_PUBLIC_ADDR=host:port


# ---- Relay binaries ------------------------------------------------------------------------------------
# Binaries are downloaded on first use into <TMPDIR>/.aether/bin.
# Override any of them with <NAME>_BIN=/path (e.g. BORE_BIN, PLAYIT_BIN, NGROK_BIN, CHISEL_BIN, FRP_BIN,
# RATHOLE_BIN, LOCALTONET_BIN) or pin <NAME>_VERSION (BORE / PLAYIT / CHISEL / FRP / RATHOLE).
# ngrok and LocalToNet use the vendor's latest download URL. Relay binaries are NOT checksum-verified;
# bake them into your image and set <NAME>_BIN if that matters to you.
# باینری‌ها هنگام اولین استفاده دانلود می‌شوند و checksum ندارند؛ در صورت حساسیت، خودتان در ایمیج بگذارید.


# =====================================================================================================
# 8) NOTIFICATIONS — اعلان‌ها (tunnel down / subscription URL change / relay errors)
# =====================================================================================================
# Webhook: JSON POST {source,event,text,content,ts,data}  (text = Slack, content = Discord)
# NOTIFY_WEBHOOK_URL=https://example.com/hook
# Telegram: create a bot with BotFather, message it once, then put the token and your chat id here.
# NOTIFY_TELEGRAM_BOT_TOKEN=123456:ABC...
# NOTIFY_TELEGRAM_CHAT_ID=123456789
# NOTIFY_TELEGRAM_API=https://api.telegram.org
# Events: tunnel_down, subscription_changed, relay_error (default: all).
# WARNING: subscription_changed contains the relay credentials — use private channels only.
# هشدار: پیام subscription_changed شامل رمز رله است؛ فقط کانال خصوصی.
# NOTIFY_EVENTS=tunnel_down,subscription_changed,relay_error
# Suppress identical messages for this many seconds.
# NOTIFY_COOLDOWN_SEC=300
